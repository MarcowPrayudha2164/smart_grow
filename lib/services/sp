import 'dart:async';
import 'dart:convert';
import 'package:dart_amqp/dart_amqp.dart';
import 'package:flutter/material.dart';

class RabbitMQSingleton {
  static final RabbitMQSingleton _instance = RabbitMQSingleton._internal();
  factory RabbitMQSingleton() => _instance;
  RabbitMQSingleton._internal();

  Client? _client;

  final StreamController<Map<String, dynamic>> _dataController =
      StreamController<Map<String, dynamic>>.broadcast();

  Stream<Map<String, dynamic>> get dataStream => _dataController.stream;

  // Data sensors
  int soilHumidity = 0;
  double temperature = 0.0;
  double waterLevel = 0.0; // distance_cm dari jarak_apps
  double waterQuality = 0.0;
  double ph = 6.2;

  // Status
  bool hasSoilData = false;
  bool hasTempData = false;
  bool hasWaterLevelData = false;
  bool hasWaterQualityData = false;
  bool hasPhData = false;

  bool isConnected = false;

  // QUEUE NAMES
  final Map<String, String> _queues = {
    'soil': 'soil_apps',
    'temp': 'suhu_apps',
    'water_level': 'jarak_apps',
    'water_quality': 'tds_apps',
  };

  final Map<String, Function(Map<String, dynamic>)> _handlers = {};

  Future<void> connect() async {
    try {
      final settings = ConnectionSettings(
        host: '195.35.23.135',
        port: 5672,
        authProvider: PlainAuthenticator('mhs_kuliah', '12345678'),
        virtualHost: '/ai-automation',
      );

      _client = Client(settings: settings);

      _setupHandlers();

      print('🔄 Connecting to RabbitMQ...');

      for (var entry in _queues.entries) {
        await _subscribeToQueue(entry.key, entry.value);
      }

      isConnected = true;
      print('✅ Connected to ${_queues.length} queues');
    } catch (e) {
      isConnected = false;
      print('❌ Connection error: $e');
    }
  }

  void _setupHandlers() {
    // Handler untuk soil_apps
    _handlers['soil'] = (Map<String, dynamic> data) {
      print('🌱 Processing soil data from soil_apps');

      final humidity = data['kelembaban_tanah'];

      if (humidity != null) {
        final parsedHumidity = _parseInt(humidity);
        soilHumidity = parsedHumidity;
        hasSoilData = true;
        print('✅ Soil humidity updated to: $soilHumidity%');

        _dataController.add({
          'type': 'soil',
          'value': soilHumidity,
          'raw_data': data,
          'timestamp': DateTime.now().millisecondsSinceEpoch,
        });
      }
    };

    // Handler untuk suhu_apps
    _handlers['temp'] = (Map<String, dynamic> data) {
      final temp = data['temperature'];
      if (temp != null) {
        temperature = _parseDouble(temp);
        hasTempData = true;
        print('✅ Temperature updated: ${temperature.toStringAsFixed(1)}°C');

        _dataController.add({
          'type': 'temperature',
          'value': temperature,
          'raw_data': data,
          'timestamp': DateTime.now().millisecondsSinceEpoch,
        });
      }
    };

    // Handler untuk jarak_apps - LEVEL AIR dengan kondisi Penuh/Kosong
    _handlers['water_level'] = (Map<String, dynamic> data) {
      final distance = data['distance_cm'];
      if (distance != null) {
        waterLevel = _parseDouble(distance);
        hasWaterLevelData = true;

        // Tentukan status Penuh/Kosong
        final waterStatus = _getWaterStatus(waterLevel);
        print('💧 Water level: ${waterLevel}cm → Status: $waterStatus');

        _dataController.add({
          'type': 'water_level',
          'value': waterLevel,
          'status': waterStatus, // Tambah status Penuh/Kosong
          'raw_data': data,
          'timestamp': DateTime.now().millisecondsSinceEpoch,
        });
      }
    };

    // Handler untuk tds_apps
    _handlers['water_quality'] = (Map<String, dynamic> data) {
      final tds = data['tds_ppm'];
      if (tds != null) {
        waterQuality = _parseDouble(tds);
        hasWaterQualityData = true;
        print('✅ Water quality updated: ${waterQuality.toInt()} ppm');

        _dataController.add({
          'type': 'water_quality',
          'value': waterQuality,
          'raw_data': data,
          'timestamp': DateTime.now().millisecondsSinceEpoch,
        });
      }
    };
  }

  // Fungsi untuk menentukan status air berdasarkan jarak
  String _getWaterStatus(double distance) {
    // Aturan:
    // - Jika jarak <= 12cm → "Penuh" 🟢
    // - Jika jarak >= 30cm → "Kosong" 🔴
    // - Di antara 12-30cm → "Sedang" 🟡

    if (distance <= 12.0) {
      return "Penuh";
    } else if (distance >= 30.0) {
      return "Kosong";
    } else {
      return "Sedang";
    }
  }

  // Bisa juga pakai threshold yang lebih fleksibel
  String getWaterLevelStatus() {
    return _getWaterStatus(waterLevel);
  }

  // Untuk mendapatkan warna berdasarkan status
  Color getWaterLevelColor() {
    final status = getWaterLevelStatus();

    switch (status) {
      case "Penuh":
        return Colors.green;
      case "Sedang":
        return Colors.orange;
      case "Kosong":
        return Colors.red;
      default:
        return Colors.grey;
    }
  }

  // Untuk mendapatkan emoji berdasarkan status
  String getWaterLevelEmoji() {
    final status = getWaterLevelStatus();

    switch (status) {
      case "Penuh":
        return "🟢";
      case "Sedang":
        return "🟡";
      case "Kosong":
        return "🔴";
      default:
        return "⚪";
    }
  }

  Future<void> _subscribeToQueue(String sensorType, String queueName) async {
    try {
      final channel = await _client!.channel();
      final queue = await channel.queue(queueName, durable: true);
      final consumer = await queue.consume();

      print('✅ Subscribed to: $queueName');

      consumer.listen((message) {
        try {
          final payload = utf8.decode(message.payload!);
          final data = json.decode(payload) as Map<String, dynamic>;

          print('\n📥 Message from $queueName ($sensorType):');

          data['queue_source'] = queueName;
          data['sensor_type'] = sensorType;

          if (_handlers.containsKey(sensorType)) {
            _handlers[sensorType]!(data);
          }

          _dataController.add(data);

          message.ack();
        } catch (e) {
          print('❌ Error: $e');
        }
      });
    } catch (e) {
      print('❌ Subscription error: $e');
    }
  }

  int _parseInt(dynamic value) {
    if (value == null) return 0;
    if (value is int) return value;
    if (value is double) return value.toInt();
    if (value is String) {
      return int.tryParse(value) ?? 0;
    }
    return 0;
  }

  double _parseDouble(dynamic value) {
    if (value == null) return 0.0;
    if (value is double) return value;
    if (value is int) return value.toDouble();
    if (value is String) {
      return double.tryParse(value) ?? 0.0;
    }
    return 0.0;
  }

  Future<void> disconnect() async {
    await _client?.close();
    isConnected = false;
    print('🔌 Disconnected');
  }

  int get activeSensorCount {
    return [
      hasTempData,
      hasSoilData,
      hasWaterLevelData,
      hasWaterQualityData,
    ].where((hasData) => hasData).length;
  }
}
